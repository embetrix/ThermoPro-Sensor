[Unit]
Description=ThermoPro sensor reader
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=exec
DynamicUser=yes
StateDirectory=thermopro-sensor
StateDirectoryMode=0750
WorkingDirectory=/var/lib/thermopro-sensor
ExecStart=/usr/local/bin/thermopro-sensor /etc/thermopro-sensor/sensors.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thermopro-sensor

[Install]
WantedBy=multi-user.target
